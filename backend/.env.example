PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lms

# AI and vector search
OPENAI_API_KEY=replace-with-openrouter-or-openai-compatible-key
OPENROUTER_API_KEY=replace-with-openrouter-key
LLM_MODEL=openai/gpt-4o-mini
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=lms-voice-attempts

# Transcription and video transcript fetching
ASSEMBLYAI_API_KEY=replace-with-assemblyai-key
GUMLET_API_KEY=replace-with-gumlet-key
YOUTUBE_API_KEY=replace-with-youtube-api-key

# WhatsApp / WAHA
WAHA_URL=https://your-waha-server.example.com
WAHA_SESSION=default
WAHA_API_KEY=replace-with-waha-api-key

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
