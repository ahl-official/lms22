PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lms

# AI and vector search
OPENAI_API_KEY=replace-with-openrouter-or-openai-compatible-key
OPENROUTER_API_KEY=replace-with-openrouter-key
LLM_MODEL=openai/gpt-4o-mini
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=lms-voice-attempts

# Transcription and video transcript fetching
ASSEMBLYAI_API_KEY=replace-with-assemblyai-key
# Primary TTS: Edge via Node (edge-tts-universal) — works on Vercel.
# Local Python edge_tts_bridge.py is only a non-Vercel backup if Node Edge fails.
# Piper is local-only backup and will not work on Vercel.
TTS_PROVIDER=edge
TTS_HI_VOICE=hi-IN-SwaraNeural
TTS_EN_VOICE=en-IN-NeerjaNeural
# Keep false while testing Edge. Set true only if Edge fails and you want Piper backup.
TTS_PIPER_FALLBACK=false
TTS_PIPER_MODEL=backend/voices/hi_IN-pratham-medium.onnx
TTS_PIPER_CONFIG=backend/voices/hi_IN-pratham-medium.onnx.json
# Use devanagari while testing a Hindi browser voice; switch to hinglish later.
HINDI_STYLE=hinglish
# Optional paid fallback/provider:
# GOOGLE_TTS_API_KEY=replace-with-google-cloud-text-to-speech-key
GUMLET_API_KEY=replace-with-gumlet-key
YOUTUBE_API_KEY=replace-with-youtube-api-key

# WhatsApp / WAHA
WAHA_URL=https://your-waha-server.example.com
WAHA_SESSION=default
WAHA_API_KEY=replace-with-waha-api-key

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
